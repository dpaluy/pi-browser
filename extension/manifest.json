{
  "manifest_version": 3,
  "name": "Pi Browser",
  "version": "0.1.0",
  "description": "Lets Pi coding agent sessions work in tabs of their own tab group.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pi Browser"
  }
}
