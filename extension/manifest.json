{
  "manifest_version": 3,
  "name": "Pi Browser",
  "version": "0.2.1",
  "description": "Lets Pi coding agent sessions work in tabs of their own tab group.",
  "minimum_chrome_version": "125",
  "key": "",
  "icons": {
    "16": "icons/ready-16.png",
    "32": "icons/ready-32.png",
    "48": "icons/ready-48.png",
    "128": "icons/ready-128.png"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pi Browser",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  }
}
